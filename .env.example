# Contador de visitas (ver README).
# remote = CounterAPI; local = solo localStorage. Por defecto: local (CounterAPI V2 exige API key; ver README).
VITE_COUNTER_MODE=
# Base de la API del contador (opcional; útil si el endpoint cambia).
VITE_COUNTER_BASE=https://api.counterapi.dev/v2
# Workspace (V2) creado en tu cuenta de CounterAPI. Debe existir: si no, responde 404 «Workspace not found».
VITE_COUNTER_NS=pokemmo-guides-hub
